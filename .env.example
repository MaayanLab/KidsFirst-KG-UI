# --- local development (npm run dev uses *_DEV values) ---
NEO4J_DEV_URL=bolt://localhost:7687
NEXT_PUBLIC_HOST_DEV=http://localhost:3000

# --- neo4j credentials (runtime only; never build args) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- public config, inlined into the image at build time ---
NEXT_PUBLIC_HOST=https://kidsfirst-kg.k8s.maayanlab.cloud
NEXT_PUBLIC_PREFIX=
NEXT_PUBLIC_ENRICHR_URL=https://maayanlab.cloud/Enrichr
NEXT_PUBLIC_GENESHOT_URL=https://maayanlab.cloud/geneshot
NEXT_PUBLIC_COOKIE_NAME=kf-kg
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_HOMEPAGE=
# unset => bundled public/schema.json is used
# NEXT_PUBLIC_SCHEMA=

TURL=
TURL_URL=https://maayanlab.cloud/turl/api/register

# --- deployment (cli/version-compose.ts -> docker-compose.yml) ---
APP_NAME=kidsfirst-kg
DOCKERHUB_NAME=
NEO4J_VERSION=5
