            "alt": "Demo-KG",
            "key": "Demo-KG_logo",
            "width": 100,
            "height": 60
        },
        "tabs": [
            {
                "endpoint": "/",
                "label": "Term & Gene Search",
                "type": "page",
                "component": "KnowledgeGraph",
                "props": {
                    "init_function": "initialize_kg",
                    "initial_query": {
                        "start": "Patient",
                        "start_term": "7316-9249",
                        "start_field": "id"
                    },
                    "subheader": {
                        "url_field": "filter",
                        "query_field": "relation"
                    }
                }
            },
            {
                "endpoint": "/patient_signal",
                "label": "Patient Multi-omic Signal",
                "type": "page",
                "component": "PatientSignal",
                "props": {
                    "title": "Patient Multi-omic Signal",
                    "description": "Genes and proteins with three or more omic alterations (PTM, expression, mutation, methylation) in a patient, and the enriched kinases, transcription factors or pathways linked to them.",
                    "default_patient_id": "7316-9249",
                    "default_enrichment_node_type": "Kinase",
                    "examples": [
                        "7316-4515",
                        "7316-5495",
                        "7316-1671"
                    ]
                }
            }
        ]
    },
