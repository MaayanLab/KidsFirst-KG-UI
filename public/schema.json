    "header": {
        "header": "Kids First Pan-Histology KG",
        "title": "Kids First Pan-Histology KG",
        "background": {
            "backgroundColor": "#000",
            "contrastText": "#FFF"
        },
        "icon": {
            "src": "https://minio.dev.maayanlab.cloud/enrichr-kg/enrichr-kg.png",
