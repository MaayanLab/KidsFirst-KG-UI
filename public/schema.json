    "header": {
        "header": "Kids First Pan-Histology KG",
        "title": "Kids First Pan-Histology KG",
        "background": {
            "backgroundColor": "#000",
            "contrastText": "#FFF"
        },
        "icon": {
            "src": "https://minio.dev.maayanlab.cloud/enrichr-kg/enrichr-kg.png",
            "favicon": "https://minio.dev.maayanlab.cloud/enrichr-kg/enrichr-kg.png",
            "faviconTitle": "KF-KG",
            "alt": "Demo-KG",
            "key": "Demo-KG_logo",
            "width": 100,
            "height": 60
        },
        "landing": {
            "subtitle": "A knowledge graph linking Kids First pediatric tumor patients to their multi-omic alterations, and to the kinases, transcription factors, pathways and drugs connected to them.",
            "prompt": "Where would you like to start?"
        },
        "tabs": [
            {
                "endpoint": "/term_search",
                "label": "Term & Gene Search",
                "type": "page",
                "component": "KnowledgeGraph",
                "landing": {
                    "icon": "graph",
                    "description": "Look up a patient, gene, PTM site, pathway, disease or drug and explore its neighborhood, or find the paths that connect two entities."
                },
                "props": {
                    "init_function": "initialize_kg",
                    "initial_query": {
                        "start": "Patient",
                        "start_term": "7316-9249",
                        "start_field": "id"
                    },
                    "subheader": {
                        "url_field": "filter",
                        "query_field": "relation"
                    }
                }
            },
            {
                "endpoint": "/patient_signal",
                "label": "Patient Multi-omic Signal",
                "type": "page",
                "component": "PatientSignal",
                "landing": {
                    "icon": "patient",
                    "description": "For a single patient, find the genes with converging omic alterations (gene and protein expression, PTM sites, mutation, methylation) and the enriched kinases, transcription factors or pathways linked to them."
                },
                "props": {
                    "title": "Patient Multi-omic Signal",
                    "description": "Genes altered in at least the chosen number of omic layers (default three) in a patient (gene or protein expression, PTM sites, mutation, methylation), and the enriched kinases, transcription factors or pathways linked to them.",
                    "default_patient_id": "7316-9249",
                    "default_enrichment_node_type": "Kinase",
                    "default_omic_signal_threshold": 3,
                    "examples": [
                        "7316-4515",
                        "7316-5495",
                        "7316-1671"
                    ]
                }
            }
        ]
    },
